{
  "name": "react-example",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "homepage": "https://<username>.github.io/<repository-name>/",
  "scripts": {
    "predev": "node scripts/prepare-source.mjs",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "node scripts/prepare-source.mjs",
    "build": "vite build && node scripts/build-service-worker.mjs",
    "release": "npm run build && node scripts/package-web-release.mjs",
    "release:standalone": "npm run build -- --mode standalone && node scripts/sync-index.mjs",
    "test:performance": "node --require ./scripts/node-os-userinfo-shim.cjs --import tsx --test scripts/test-performance-cache.ts",
    "test:offline": "node scripts/test-offline-build.mjs",
    "test:jobs-search": "node --require ./scripts/node-os-userinfo-shim.cjs --import tsx --test scripts/test-job-search.ts",
    "test:smart-search": "node --require ./scripts/node-os-userinfo-shim.cjs --import tsx --test scripts/test-smart-search.ts",
    "test:service-form": "node --require ./scripts/node-os-userinfo-shim.cjs --import tsx --test scripts/test-service-form.ts",
    "test:service-social-links": "node --require ./scripts/node-os-userinfo-shim.cjs --import tsx --test scripts/test-service-social-links.ts",
    "test:join-flow": "node --require ./scripts/node-os-userinfo-shim.cjs --import tsx --test scripts/test-join-flow.ts",
    "test:sliders-visual": "node scripts/test-sliders-visual.mjs",
    "test:content-slides": "node --require ./scripts/node-os-userinfo-shim.cjs --import tsx --test scripts/test-content-slides.ts",
    "start": "node --require ./scripts/node-os-userinfo-shim.cjs --import tsx server.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "android:sync": "npm run build && node --require ./scripts/node-os-userinfo-shim.cjs ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:aab": "cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@emotion/is-prop-valid": "^1.4.0",
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "localforage": "^1.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0",
    "uuid": "^13.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.2"
  }
}
